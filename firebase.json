{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "firestore.rules",
      "firestore.indexes.json",
      ".*",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "tools/**",
      "scripts/**",
      "supabase/**",
      "package.json",
      "package-lock.json",
      "*.md",
      "*.log"
    ],
    "headers": [
      {
        "source": "assets/config.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "**/*.@(js|css)",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=300"
          }
        ]
      }
    ]
  },
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "auth": {
    "providers": {
      "emailPassword": true
    }
  },
  "emulators": {
    "auth": {
      "port": 9199
    },
    "firestore": {
      "port": 8185
    },
    "hosting": {
      "port": 5055
    },
    "ui": {
      "enabled": false
    },
    "singleProjectMode": true
  }
}
