{
  "name": "emeksermaye",
  "private": true,
  "version": "0.3.0",
  "description": "Emek Sermaye tanıtım sitesi ve yatırımcı platformu",
  "type": "module",
  "scripts": {
    "dev": "firebase emulators:start --only auth,firestore,hosting --project emeksermaye",
    "seed:local": "node tools/seed.mjs --emulator",
    "test:rules": "firebase emulators:exec --only auth,firestore --project emeksermaye \"node tools/test-rules.mjs\"",
    "seed": "node tools/seed.mjs",
    "deploy": "firebase deploy --only hosting,firestore --project emeksermaye",
    "test:hesap": "node tools/test-hesap.mjs",
    "test:sim": "node tools/test-simulasyon.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
